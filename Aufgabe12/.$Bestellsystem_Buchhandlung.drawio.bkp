            <mxPoint x="-12" y="4" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Generalisierung PhysicalBook → Book -->
        <mxCell id="e_pb" value="" style="endArrow=block;endSize=16;endFill=0;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="pbook" target="book">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Generalisierung EBook → Book -->
        <mxCell id="e_eb" value="" style="endArrow=block;endSize=16;endFill=0;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="ebook" target="book">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Gerichtete Assoziation Order → IDiscountRule -->
        <mxCell id="e_or" value="verwendet ▶" style="endArrow=open;endFill=0;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="order" target="rule">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_or_t" value="0..*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;" connectable="0" vertex="1" parent="e_or">
          <mxGeometry x="1" relative="1" as="geometry">
            <mxPoint x="8" y="-6" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Realisierungen → IDiscountRule -->
        <mxCell id="e_nod" value="" style="endArrow=block;endSize=16;endFill=0;dashed=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="nod" target="rule">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_memd" value="" style="endArrow=block;endSize=16;endFill=0;dashed=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="memd" target="rule">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ebd" value="" style="endArrow=block;endSize=16;endFill=0;dashed=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="ebd" target="rule">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== Titel ===================== -->
        <mxCell id="title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Bestellsystem Buchhandlung – UML-Klassendiagramm&lt;/b&gt;&lt;br&gt;Vertiefungsaufgabe 12" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="800" height="60" as="geometry" />
        </mxCell>

        <!-- ===================== Legende / Notation ===================== -->
        <mxCell id="legend" value="&lt;b&gt;Notation&lt;/b&gt;&lt;br&gt;+ public&amp;nbsp;&amp;nbsp; - private&amp;nbsp;&amp;nbsp; # protected&lt;br&gt;&lt;i&gt;kursiv&lt;/i&gt; = abstrakt&amp;nbsp;&amp;nbsp; &lt;u&gt;unterstrichen&lt;/u&gt; = static&lt;br&gt;«get» / «set» = C#-Property" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="360" height="110" as="geometry" />
        </mxCell>

        <!-- ===================== Begründung der Beziehungen ===================== -->
        <mxCell id="note" value="&lt;b&gt;Begründung der Beziehungen&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Generalisierung&lt;/b&gt; PhysicalBook / EBook → Book: Beide sind ein Buch (ist-ein-Beziehung). Book ist abstrakt, damit kein generisches Buch erstellt werden kann. GetPrice() ist abstrakt und wird pro Buchtyp überschrieben (Polymorphie): PhysicalBook = Grundpreis + 2.00 Versand, EBook = Grundpreis.&lt;br&gt;• &lt;b&gt;Assoziation&lt;/b&gt; Customer 1 — 0..* Order: Eine Bestellung gehört immer genau einem Kunden, ein Kunde kann beliebig viele Bestellungen aufgeben. Keine Komposition, weil die Bestellung kein Bestandteil des Kunden ist (sie muss z. B. für die Buchhaltung weiter existieren).&lt;br&gt;• &lt;b&gt;Aggregation&lt;/b&gt; Order ◇— Book (0..* : 1..*): Eine Bestellung enthält mindestens ein Buch. Die Bücher existieren aber unabhängig von der Bestellung (Sortiment) und können in mehreren Bestellungen vorkommen, darum Aggregation und keine Komposition.&lt;br&gt;• &lt;b&gt;Gerichtete Assoziation&lt;/b&gt; Order → IDiscountRule (0..*): Die Bestellung kennt ihre Rabattregeln, die Regeln kennen die Bestellung nicht.&lt;br&gt;• &lt;b&gt;Realisierung&lt;/b&gt; NoDiscount / MemberDiscount / EbookDiscount ⇢ IDiscountRule: Strategy-Pattern. Eine neue Rabattregel ist einfach eine neue Klasse, die das Interface implementiert – Order muss dafür nicht angepasst werden (Open/Closed-Prinzip)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacing=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="1100" width="1730" height="210" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
