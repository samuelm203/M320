        <!-- ===================== Beziehungen ===================== -->
        <!-- Assoziation Customer 1 — 0..* Order -->
        <mxCell id="e_co" value="gibt auf ▶" style="endArrow=none;html=1;rounded=0;verticalAlign=bottom;" edge="1" parent="1" source="cust" target="order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_co_s" value="1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=top;" connectable="0" vertex="1" parent="e_co">
          <mxGeometry x="-1" relative="1" as="geometry">
            <mxPoint x="8" y="4" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_co_t" value="0..*" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=top;" connectable="0" vertex="1" parent="e_co">
          <mxGeometry x="1" relative="1" as="geometry">
            <mxPoint x="-8" y="4" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Aggregation Order ◇— Book -->
        <mxCell id="e_ob" value="enthält ▶" style="endArrow=open;endFill=0;startArrow=diamondThin;startFill=0;startSize=16;endSize=10;html=1;rounded=0;verticalAlign=bottom;" edge="1" parent="1" source="order" target="book">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ob_s" value="0..*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=top;" connectable="0" vertex="1" parent="e_ob">
