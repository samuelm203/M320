          <mxGeometry y="26" width="400" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ebd_l" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="ebd">
